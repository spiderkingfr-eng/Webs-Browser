// Cloudflare's settings for the Web AI server, used by setup.cmd (wrangler deploy).
// The key and the codes are secrets, set by setup.cmd (wrangler secret put), never written here.
{
  "name": "web-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // the storage for the daily counts (made by the first deploy; leave out "id" on a new account)
  "kv_namespaces": [{ "binding": "LIMITS", "id": "ed2500363e6d4b50bdaf5469f80eb50e" }],
  // OPEN: anyone using Webs Browser can ask without a code, 25 a day per device,
  // 100 per internet connection and 150 for everyone together
  "vars": { "OPEN": "true" },
  // every minute the worker looks for a new version of the iPhone app (every 10 minutes), sends the
  // daily word reminders and scheduled news, carries on big sends, checks the websites you watch
  // (every 5 minutes), works out the dashboard's numbers (hourly) and sends the weekly report
  "triggers": { "crons": ["* * * * *"] }
}
